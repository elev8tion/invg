# =====================================================
# NoCodeBackend -- SERVER-SIDE ONLY
# =====================================================
# No REACT_APP_ prefix, so Create React App cannot inline these into the
# browser bundle. They are read by server.js (local) and the Netlify Function
# (production). The secret key is full CRUD on the database -- never ship it
# to the client.

NCB_INSTANCE=36905_invg

# Auto-generated when the database was created (create_database MCP tool).
# Regenerate from the NCB dashboard if it is ever exposed.
NCB_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxx

# Only needed if you adopt NCB end-user auth later. Unused by the app today.
NCB_AUTH_API_URL=https://app.nocodebackend.com/api/user-auth
NCB_DATA_API_URL=https://app.nocodebackend.com/api/data
NCB_APP_URL=https://app.nocodebackend.com

# Optional override; defaults to https://api.nocodebackend.com
# NCB_BASE_URL=https://api.nocodebackend.com

# =====================================================
# Client-side (safe to inline into the bundle)
# =====================================================

# Point the browser at a different proxy origin. Defaults to /api/ncb.
# REACT_APP_NCB_PROXY_BASE=/api/ncb

# Email Configuration (optional - for email integration)
REACT_APP_EMAIL_SERVICE=sendgrid
REACT_APP_EMAIL_API_KEY=your_email_api_key
REACT_APP_EMAIL_FROM=noreply@yourdomain.com
